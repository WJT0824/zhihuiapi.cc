# 郅绘中转站（new-api）运行时环境变量
# 复制为 .env 使用；.env 含密钥，不要提交到仓库。

# ---------- new-api ----------
TZ=Asia/Shanghai
# 会话与数据加密密钥，install.sh 会自动生成；两者不要改动，改了会导致渠道密钥无法解密
SESSION_SECRET=
CRYPTO_SECRET=
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=zhihui-1

# 计费映射（与 tokenflux.cloud 一致）
# QuotaPerUnit=500000、美元汇率 7.3、按美元显示额度
