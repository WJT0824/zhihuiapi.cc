# 复制成 .env 后使用；install.sh 会自动生成随机密钥。
# 不要提交真实值到仓库。

# ---------- 业务 Node 服务 ----------
# 管理员密码：生产环境必须设置，否则服务拒绝启动
ZH_ADMIN_KEY=replace-with-a-long-random-password
# 数据目录（容器内路径，由 compose 挂载持久卷）
# ZH_DATA_DIR=/app/data
# 允许跨域的来源，默认同源
# CORS_ORIGIN=https://zhihuiapi.cc
# 对外暴露的接口根地址，用于生成文档与插件配置
PUBLIC_API_ORIGIN=https://api.zhihuiapi.cc

# 平台账号模式的上游网关（可留空，等价于在后台配置）
# AI_BASE_URL=https://tokenflux.cloud/
# AI_API_KEY=sk-xxx
# AI_IMAGE_MODEL=gpt-image-2

# ComfyUI 工作流（高清放大 / 图转矢量）
# COMFY_BASE_URL=http://127.0.0.1:8188
# COMFY_API_KEY=
# COMFY_TIMEOUT_MS=600000

# 站点侧读取 new-api 的默认地址与令牌（也可只在运营后台填写）
NEWAPI_BASE_URL=https://relay.zhihuiapi.cc
NEWAPI_ADMIN_TOKEN=

# 兑换码签名（install.sh 自动生成）
ZH_RECHARGE_SHORT_SECRET=
ZH_RECHARGE_SHORT_SECRET_LEGACY=

# ---------- new-api 中转站 ----------
TZ=Asia/Shanghai
# 以下两个由 install.sh 自动生成
SESSION_SECRET=
CRYPTO_SECRET=
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=zhihui-1
# 计费映射：1 积分 = 10000 quota = 0.1 元
# 在 new-api 后台设置里填 QuotaPerUnit=700000、美元汇率=7
